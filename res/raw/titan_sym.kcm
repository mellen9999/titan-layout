# titan-layout — symbols, arrows, escape and the shift tier on fn(sym) only
# generated by gen.py from /system/usr/keychars/TitanKey.kcm; do not hand-edit.

type OVERLAY

key A {
    label:                              'A'
    base:                               'a'
    shift, capslock:                    'A'
    alt:                                '@'
    shift+alt, capslock+alt:            none
    sym:                                replace TAB
}

key B {
    label:                              'B'
    base:                               'b'
    shift, capslock:                    'B'
    alt:                                '.'
    shift+alt, capslock+alt:            none
    sym:                                '<'
}

key C {
    label:                              'C'
    number:                             '8'
    base:                               'c'
    shift, capslock:                    'C'
    alt:                                '8'
    shift+alt, capslock+alt:            none
    sym:                                '['
}

key D {
    label:                              'D'
    number:                             '5'
    base:                               'd'
    shift, capslock:                    'D'
    alt:                                '5'
    shift+alt, capslock+alt:            none
    sym:                                '%'
}

key E {
    label:                              'E'
    number:                             '2'
    base:                               'e'
    shift, capslock:                    'E'
    alt:                                '2'
    shift+alt, capslock+alt:            none
