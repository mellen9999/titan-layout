    label:                              'H'
    base:                               'h'
    shift, capslock:                    'H'
    alt:                                '#'
    shift+alt, capslock+alt:            none
    sym:                                replace DPAD_LEFT
}

key I {
    label:                              'I'
    base:                               'i'
    shift, capslock:                    'I'
    alt:                                '_'
    shift+alt, capslock+alt:            none
    sym:                                '|'
}

key J {
    label:                              'J'
    base:                               'j'
    shift, capslock:                    'J'
    alt:                                '+'
    shift+alt, capslock+alt:            none
    sym:                                replace DPAD_DOWN
}

key K {
    label:                              'K'
    base:                               'k'
    shift, capslock:                    'K'
    alt:                                '"'
    shift+alt, capslock+alt:            none
